<file path="standard.site-main/app/lib/lexicon.ts">
import publicationLexicon from "../data/lexicons/publication.json";
import documentLexicon from "../data/lexicons/document.json";
import subscriptionLexicon from "../data/lexicons/graph.subscription.json";
import recommendLexicon from "../data/lexicons/graph.recommend.json";
import themeBasicLexicon from "../data/lexicons/theme.basic.json";
import themeColorLexicon from "../data/lexicons/theme.color.json";
import authFullLexicon from "../data/lexicons/authFull.json";
import authSocialLexicon from "../data/lexicons/authSocial.json";
import { getDescriptionOverride, getPropertyOrder } from "../data/lexicon-overrides";

export interface LexiconProperty {
  type: string;
  description?: string;
  format?: string;
  maxLength?: number;
  maxGraphemes?: number;
  maxSize?: number;
  accept?: string[];
  ref?: string;
  default?: unknown;
  items?: {
    type: string;
    maxLength?: number;
    maxGraphemes?: number;
    refs?: string[];
    closed?: boolean;
  };
}

export interface LexiconDef {
  type: string;
  description?: string;
  required?: string[];
  properties?: Record<string, LexiconProperty>;
  // For record types, the object schema is nested inside 'record'
  record?: {
    type: string;
    description?: string;
    required?: string[];
    properties?: Record<string, LexiconProperty>;
  };
}

export interface LexiconSchema {
  lexicon: number;
  id: string;
  $type: string;
  description?: string;
  defs: Record<string, LexiconDef>;
}

const lexiconCache: Record<string, LexiconSchema> = {
  "site.standard.publication": publicationLexicon as LexiconSchema,
  "site.standard.document": documentLexicon as LexiconSchema,
  "site.standard.graph.subscription": subscriptionLexicon as LexiconSchema,
  "site.standard.graph.recommend": recommendLexicon as LexiconSchema,
  "site.standard.theme.basic": themeBasicLexicon as LexiconSchema,
  "site.standard.theme.color": themeColorLexicon as LexiconSchema,
  "site.standard.authFull": authFullLexicon as LexiconSchema,
  "site.standard.authSocial": authSocialLexicon as LexiconSchema,
};

export function getLexicon(nsid: string): LexiconSchema | null {
  return lexiconCache[nsid] ?? null;
}

export function getAllLexicons() {
  const publication = getLexicon("site.standard.publication");
  const document = getLexicon("site.standard.document");

  return { publication, document };
}

export function getAllSchemas(): Record<string, LexiconSchema> {
  return { ...lexiconCache };
}

// Helper to parse lexicon properties into a display-friendly format
export interface ParsedField {
  name: string;
  type: string;
  required: boolean;
  description?: string;
  constraints: string[];
  ref?: string;      // Single ref - expandable
  refs?: string[];   // Union refs - badges only
}

// Resolve a reference to its LexiconDef
export function resolveRef(ref: string, currentSchema: LexiconSchema): LexiconDef | null {
  // Handle #localRef
  if (ref.startsWith("#")) {
    const defName = ref.slice(1);
    return currentSchema.defs[defName] ?? null;
  }

  // Handle nsid#defName (e.g., site.standard.theme.color#rgb)
  if (ref.includes("#")) {
    const [nsid, defName] = ref.split("#");
    const schema = getLexicon(nsid);
    return schema?.defs[defName] ?? null;
  }

  // Handle full NSID (e.g., site.standard.theme.basic)
  const schema = getLexicon(ref);
  return schema?.defs.main ?? null;
}

// Helper to get the object schema from a def (handles record types)
function getObjectSchema(def: LexiconDef): { properties?: Record<string, LexiconProperty>; required?: string[] } | null {
  // For record types, the object schema is nested inside 'record'
  if (def.type === 'record' && def.record) {
    return def.record;
  }
  // For object types, properties are directly on the def
  if (def.type === 'object' && def.properties) {
    return def;
  }
  return null;
}

// Parse a LexiconDef into ParsedField[]
export function parseDefFields(
  def: LexiconDef,
  lexiconId?: string,
  defName?: string | null
): ParsedField[] {
  const schema = getObjectSchema(def);
  if (!schema?.properties) {
    return [];
  }

  const requiredFields = new Set(schema.required || []);
  const propertyOrder = lexiconId ? getPropertyOrder(lexiconId, defName ?? null) : undefined;

  // Sort entries by custom order if defined
  let entries = Object.entries(schema.properties);
  if (propertyOrder) {
    entries = entries.sort((a, b) => {
      const indexA = propertyOrder.indexOf(a[0]);
      const indexB = propertyOrder.indexOf(b[0]);
      // Properties not in order list go to the end
      const orderA = indexA === -1 ? Infinity : indexA;
      const orderB = indexB === -1 ? Infinity : indexB;
      return orderA - orderB;
    });
  }

  return entries.map(([name, prop]) => {
    const constraints: string[] = [];

    if (prop.maxLength) constraints.push(`maxLength: ${prop.maxLength}`);
    if (prop.maxGraphemes) constraints.push(`maxGraphemes: ${prop.maxGraphemes}`);
    if (prop.maxSize) constraints.push(`maxSize: ${formatBytes(prop.maxSize)}`);
    if (prop.accept) constraints.push(`accept: [${prop.accept.join(", ")}]`);

    // Handle array items constraints
    if (prop.items) {
      if (prop.items.maxLength) constraints.push(`items.maxLength: ${prop.items.maxLength}`);
      if (prop.items.maxGraphemes) constraints.push(`items.maxGraphemes: ${prop.items.maxGraphemes}`);
    }

    // Build the type string
    let type = prop.type;
    if (prop.format) type = `${prop.type}:${prop.format}`;
    if (prop.ref) type = prop.ref;
    if (prop.type === "array" && prop.items) {
      type = `array<${prop.items.type}>`;
    }

    // Get refs for union types
    const refs = (prop as { refs?: string[] }).refs;

    // Check for description override
    const description = lexiconId
      ? getDescriptionOverride(lexiconId, defName ?? null, name) ?? prop.description
      : prop.description;

    return {
      name,
      type,
      required: requiredFields.has(name),
      description,
      constraints,
      ref: prop.ref,
      refs,
    };
  });
}

export function parseLexiconFields(schema: LexiconSchema): ParsedField[] {
  const mainDef = schema.defs.main;
  if (!mainDef) {
    return [];
  }
  return parseDefFields(mainDef, schema.id, "main");
}

function formatBytes(bytes: number): string {
  if (bytes >= 1_000_000) return `${bytes / 1_000_000}MB`;
  if (bytes >= 1_000) return `${bytes / 1_000}KB`;
  return `${bytes}B`;
}

// Get nested definitions (like #preferences)
export function getNestedDefs(schema: LexiconSchema): Record<string, LexiconDef> {
  const nested: Record<string, LexiconDef> = {};

  for (const [key, def] of Object.entries(schema.defs)) {
    if (key !== "main") {
      nested[key] = def;
    }
  }

  return nested;
}
</file>

<file path="standard.site-main/app/lib/mdx-to-markdown.ts">
import { readFile } from 'node:fs/promises'
import { join } from 'node:path'

export async function getDocMarkdown(slugPath: string): Promise<string> {
    const filePath = join(process.cwd(), 'content', 'docs', `${slugPath}.mdx`)
    const raw = await readFile(filePath, 'utf-8')
    return mdxToMarkdown(raw)
}

async function mdxToMarkdown(content: string): Promise<string> {
    let result = content

    // Remove frontmatter
    result = result.replace(/^---\n[\s\S]*?\n---\n*/, '')

    // Remove import lines
    result = result.replace(/^import\s+.*$/gm, '')

    // Replace <StandardSite /> with plain text
    result = result.replace(/<StandardSite\s*\/>/g, 'Standard.site')

    // Replace <LinkCard> components with markdown links, fetching OG titles
    const linkCardRegex = /<LinkCard\s+([\s\S]*?)\/>/g
    const linkCards: { match: string; url: string; title: string }[] = []

    for (const m of content.matchAll(linkCardRegex)) {
        const attrs = m[1]
        const url = attrs.match(/url=["']([^"']*)["']/)?.[1] ?? ''
        const title = attrs.match(/title=["']([^"']*)["']/)?.[1] ?? ''
        linkCards.push({ match: m[0], url, title })
    }

    // Fetch OG titles in parallel for cards without explicit titles
    const titles = await Promise.all(
        linkCards.map(async (card) => {
            if (card.title) return card.title
            return await fetchOgTitle(card.url)
        })
    )

    for (let i = 0; i < linkCards.length; i++) {
        result = result.replace(linkCards[i].match, `[${titles[i]}](${linkCards[i].url})`)
    }

    // Replace <Table> components with markdown tables
    // The closing /> is always on its own line, so we anchor to that to avoid
    // matching /> inside JSX fragments like </>
    result = result.replace(/<Table\s+([\s\S]*?)\n\/>/g, (_match, body) => {
        return parseTable(body)
    })

    // Clean up extra blank lines
    result = result.replace(/\n{3,}/g, '\n\n')

    return result.trim() + '\n'
}

async function fetchOgTitle(url: string): Promise<string> {
    try {
        const res = await fetch(url, {
            next: { revalidate: 86400 },
            headers: {
                'User-Agent': 'Mozilla/5.0 (compatible; Standard.site/1.0; +https://standard.site)'
            },
            signal: AbortSignal.timeout(5000),
        })

        if (!res.ok) return url

        const html = await res.text()
        const ogTitle =
            html.match(/<meta[^>]*property=["']og:title["'][^>]*content=["']([^"']*)["']/i)?.[1] ||
            html.match(/<meta[^>]*content=["']([^"']*)["'][^>]*property=["']og:title["']/i)?.[1] ||
            html.match(/<title[^>]*>([^<]*)<\/title>/i)?.[1]

        return ogTitle?.trim() || url
    } catch {
        return url
    }
}

function parseTable(body: string): string {
    const headersMatch = body.match(/headers=\{(\[.*?\])}/)

    const rowsMatch = body.match(/rows=\{(\[[\s\S]*)\}\s*$/)

    if (!headersMatch || !rowsMatch) return body

    let headers: string[]
    try {
        // Convert single quotes to double quotes for JSON parsing
        headers = JSON.parse(headersMatch[1].replace(/'/g, '"'))
    } catch {
        return body
    }

    const rows = parseRows(rowsMatch[1])

    // Build markdown table
    const headerRow = '| ' + headers.join(' | ') + ' |'
    const separator = '| ' + headers.map(() => '---').join(' | ') + ' |'
    const dataRows = rows.map(row =>
        '| ' + row.map(cell => cell.replace(/\|/g, '\\|')).join(' | ') + ' |'
    )

    return [headerRow, separator, ...dataRows].join('\n')
}

function parseRows(raw: string): string[][] {
    const rows: string[][] = []

    // Strip outer brackets
    const inner = raw.trim().replace(/^\[/, '').replace(/\]$/, '')

    // Split into individual row arrays by matching balanced brackets
    const rowStrings = splitRows(inner)

    for (const rowStr of rowStrings) {
        const cells = splitCells(rowStr)
        if (cells.length > 0) {
            rows.push(cells.map(cell => jsxToPlainText(cell.trim())))
        }
    }

    return rows
}

function splitRows(content: string): string[] {
    const rows: string[] = []
    let depth = 0
    let current = ''
    let inString = false
    let stringChar = ''
    let inJsx = false

    for (let i = 0; i < content.length; i++) {
        const char = content[i]
        const prev = content[i - 1]

        if (inString) {
            current += char
            if (char === stringChar && prev !== '\\') {
                inString = false
            }
            continue
        }

        // Track JSX fragments: <> and </>
        if (char === '<' && content[i + 1] === '>') {
            inJsx = true
            current += char
            continue
        }
        if (char === '<' && content[i + 1] === '/' && content[i + 2] === '>') {
            inJsx = false
            current += char
            continue
        }

        // Only treat quotes as string delimiters outside JSX content
        if (!inJsx && (char === "'" || char === '"' || char === '`')) {
            inString = true
            stringChar = char
            current += char
            continue
        }

        if (char === '[') {
            if (depth > 0) current += char
            depth++
        } else if (char === ']') {
            depth--
            if (depth === 0) {
                rows.push(current.trim())
                current = ''
            } else {
                current += char
            }
        } else if (depth > 0) {
            current += char
        }
    }

    return rows
}

function splitCells(row: string): string[] {
    const cells: string[] = []
    let current = ''
    let depth = 0
    let inString = false
    let stringChar = ''
    let angleBracketDepth = 0
    let inJsx = false

    for (let i = 0; i < row.length; i++) {
        const char = row[i]
        const prev = row[i - 1]

        if (inString) {
            current += char
            if (char === stringChar && prev !== '\\') {
                inString = false
            }
            continue
        }

        // Track JSX fragments: <> and </>
        if (char === '<' && row[i + 1] === '>') {
            inJsx = true
            angleBracketDepth++
            current += char
            continue
        }
        if (char === '<' && row[i + 1] === '/' && row[i + 2] === '>') {
            inJsx = false
            current += char
            continue
        }

        // Only treat quotes as string delimiters outside JSX content
        if (!inJsx && (char === "'" || char === '"' || char === '`')) {
            inString = true
            stringChar = char
            current += char
            continue
        }

        if (char === '{') { depth++; current += char; continue }
        if (char === '}') { depth--; current += char; continue }
        if (char === '<') { angleBracketDepth++; current += char; continue }
        if (char === '>') { angleBracketDepth--; current += char; continue }

        if (char === ',' && depth === 0 && angleBracketDepth === 0) {
            cells.push(current.trim())
            current = ''
            continue
        }

        current += char
    }

    if (current.trim()) cells.push(current.trim())

    return cells
}

function jsxToPlainText(cell: string): string {
    // Remove wrapping quotes from plain strings
    if (/^['"].*['"]$/.test(cell)) {
        return cell.slice(1, -1)
    }

    // Handle JSX expressions wrapped in {<>...</>} or <>...</>
    let text = cell

    // Strip outer JSX expression wrapper: {<>...</>}
    text = text.replace(/^\{?<>/, '').replace(/<\/>\}?$/, '')

    // Convert <code>...</code> to backtick-wrapped text
    text = text.replace(/<code>([^<]*)<\/code>/g, '`$1`')

    // Convert <a href="...">...</a> to markdown links
    text = text.replace(/<a\s+href=["']([^"']*)["'][^>]*>([^<]*)<\/a>/g, '[$2]($1)')

    // Strip any remaining JSX tags
    text = text.replace(/<[^>]+>/g, '')

    // Clean up whitespace
    text = text.replace(/\s+/g, ' ').trim()

    return text
}
</file>

