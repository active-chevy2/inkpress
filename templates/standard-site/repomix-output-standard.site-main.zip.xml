when:
  - event: [ 'push' ]
    branch: [ 'main' ]
  - event: [ 'manual' ]

engine: 'nixery'

clone:
  skip: false
  depth: 1
  submodules: false

dependencies:
  nixpkgs:
    - nodejs
    - coreutils
    - curl
    - glibc
  github:NixOS/nixpkgs/nixpkgs-unstable:
    - bun

environment:
  SITE_PATH: './out'
  SITE_NAME: 'Standard.site'
  ATP_IDENTIFIER: 'standard.site'

steps:
  - name: build site
    command: |
      export PATH="$HOME/.bun/bin:$HOME/.nix-profile/bin:$PATH"
      export NODE_OPTIONS="--max-old-space-size=4096"
      bun install --frozen-lockfile
      bun install -g sequoia-cli@0.5.6
      bunx tsx scripts/cleanup-duplicates.ts
      sequoia sync
      sequoia publish
      bun node_modules/.bin/next build
      sequoia inject

  - name: deploy to wisp
    command: |
      curl -L https://sites.wisp.place/nekomimi.pet/wisp-cli-binaries/wisp-cli-x86_64-linux -o wisp-cli
      chmod +x wisp-cli
      ./wisp-cli deploy "$ATP_IDENTIFIER" \
        --path "$SITE_PATH" \
        --site "$SITE_NAME" \
        --password "$ATP_APP_PASSWORD"
