    "background": {
      "$type": "site.standard.theme.color#rgb",
      "r": 255,
      "g": 255,
      "b": 255
    },
    "foreground": {
      "$type": "site.standard.theme.color#rgb",
      "r": 31,
      "g": 41,
      "b": 55
    },
    "accent": {
      "$type": "site.standard.theme.color#rgb",
      "r": 59,
      "g": 130,
      "b": 246
    },
    "accentForeground": {
      "$type": "site.standard.theme.color#rgb",
      "r": 255,
      "g": 255,
      "b": 255
    }
  },
  "preferences": {
    "showInDiscover": true
  }
}
```

